[Unit]
Description=Brasília Livre — manifestacao-local
Documentation=file:/opt/manifestacao-local/current/deploy/README.md
After=network-online.target postgresql.service
Wants=network-online.target
# PostgreSQL indisponível por mais de 25 s não deve impedir a recuperação.
# RestartSec limita as tentativas sem exigir intervenção após uma falha longa.
StartLimitIntervalSec=0

[Service]
Type=simple
User=manifestacao-local
Group=manifestacao-local
WorkingDirectory=/opt/manifestacao-local/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4180
Environment=DATA_DIR=/var/lib/manifestacao-local
EnvironmentFile=/etc/manifestacao-local.env
ExecStartPre=/usr/bin/node --check src/server.js
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=45
UMask=0077
StateDirectory=manifestacao-local
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/manifestacao-local
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=65536
SyslogIdentifier=manifestacao-local
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
