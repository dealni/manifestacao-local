{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/protocol.js", "src/runtime-config.js", "types/**/*.d.ts", "types/**/*.test.ts"],
  "exclude": ["node_modules", "public", "data"]
}
